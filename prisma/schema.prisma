generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase บน Vercel: DATABASE_URL = pooler (6543), DIRECT_URL = direct/session (5432) สำหรับ migrate
  // Docker / local: ใส่ค่าเดียวกันทั้งสองตัว
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Role ที่กำหนดได้เอง — `level` ใช้ตัดสินสิทธิ์ (ดู src/lib/permissions.ts)
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

/// ทีมซ้อนได้ 2 ชั้น: ทีมใหญ่ (parentId = null) → ทีมย่อย
model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  parentId  String?
  parent    Team?        @relation("TeamTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Team[]       @relation("TeamTree")
  members   TeamMember[]
  standups  Standup[]
  createdAt DateTime     @default(now())

  @@index([parentId])
}

/// สมาชิกทีม — คนหนึ่งอยู่ได้หลายทีม, isLead = หัวหน้าของทีมนี้ (เห็นภาพรวมทีมนี้ + ทีมย่อย)
model TeamMember {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([userId, teamId])
  @@index([teamId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  active       Boolean      @default(true)
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  memberships  TeamMember[]
  standups     Standup[]
  createdAt    DateTime     @default(now())
}

/// Daily scrum หนึ่งรายการต่อคน ต่อทีม ต่อวัน — กระดานของแต่ละทีมแยกกัน
/// teamId = null เฉพาะข้อมูลเก่าที่เจ้าของไม่มีทีม หรือทีมถูกลบไปแล้ว
model Standup {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  date           DateTime @db.Date
  /// [{ text, progress }] — ยกมาจาก todayTasks ของครั้งก่อน แล้วอัปเดต % ความคืบหน้า (100 = เสร็จ)
  yesterdayTasks Json     @default("[]")
  /// [{ text, progress? }] — progress = % ตั้งต้นของงานที่ยกมาทำต่อ
  todayTasks     Json     @default("[]")
  blockers       String?
  notWorking     String?
  workingWell    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, teamId, date])
  @@index([teamId, date])
  @@index([date])
}
