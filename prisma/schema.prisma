generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase บน Vercel: DATABASE_URL = pooler (6543), DIRECT_URL = direct/session (5432) สำหรับ migrate
  // Docker / local: ใส่ค่าเดียวกันทั้งสองตัว
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Role ระดับระบบ — `level` ≥ 100 = ผู้ดูแลแพลตฟอร์ม (ดู src/lib/permissions.ts)
/// สิทธิ์ในทีมอยู่ที่ TeamMember.access และชื่อบทบาทในทีมอยู่ที่ TeamMember.title
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// ทีมซ้อนได้ 2 ชั้น: ทีมใหญ่ (parentId = null) = workspace ของลูกค้าแต่ละราย → ทีมย่อย
/// ชื่อทีมใหญ่ซ้ำกันได้ (คนละลูกค้า) — ชื่อทีมย่อยห้ามซ้ำภายในทีมใหญ่เดียวกัน
model Team {
  id           String       @id @default(cuid())
  name         String
  parentId     String?
  parent       Team?        @relation("TeamTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Team[]       @relation("TeamTree")
  members      TeamMember[]
  standups     Standup[]
  tasks        Task[]
  invites      Invite[]
  /// เลขงานล่าสุดที่ออกไปแล้วของทีมนี้ (งานใหม่ได้เลขถัดไป — ดู src/lib/task-store.ts)
  taskSeq      Int          @default(0)
  /// ลิงก์ห้องประชุมประจำทีม (Google Meet / Zoom / Jitsi ฯลฯ) — ทีมย่อยที่ไม่ได้ตั้งใช้ของทีมแม่
  meetingUrl   String?
  notes        Note[]
  labels       Label[]
  refs         Ref[]
  subscription Subscription?
  /// มีค่า = "พื้นที่ส่วนตัว" ของผู้ใช้คนนี้ (ทีมที่มีเจ้าของคนเดียว เชิญคนอื่นไม่ได้) — คนละ 1 พื้นที่
  /// ทำให้คนที่ไม่มีทีมใช้ งาน / บันทึกประจำวัน / โน้ต ได้เหมือนกันโดยไม่ต้องมีโค้ดแยก
  personalOfId String?      @unique
  personalOf   User?        @relation("PersonalSpace", fields: [personalOfId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([parentId, name])
  @@index([parentId])
}

/// สิทธิ์ของสมาชิกในทีมนั้น (ไม่ใช่สิทธิ์ระดับระบบ)
/// OWNER = เจ้าของทีม จัดการสมาชิก/ตั้งค่าทีมได้ · LEAD = เห็นภาพรวมและมอบหมายงานในทีมนี้ + ทีมย่อย · MEMBER = สมาชิกทั่วไป
enum TeamAccess {
  OWNER
  LEAD
  MEMBER
}

/// สมาชิกทีม — คนหนึ่งอยู่ได้หลายทีม สิทธิ์และชื่อบทบาทกำหนดแยกต่อทีม
model TeamMember {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  access       TeamAccess @default(MEMBER)
  /// ชื่อบทบาทในทีมนี้ที่ตั้งเองได้ เช่น Dev, PM, PO, Scrum Master (ไม่มีผลต่อสิทธิ์)
  title        String?
  /// false = ดูแล/สังเกตการณ์อย่างเดียว ไม่ต้องเช็กอินและไม่ถูกนับในภาพรวม
  participates Boolean    @default(true)
  /// เลิกใช้แล้ว — ใช้ access แทน (คงคอลัมน์ไว้ให้ถอยกลับได้ จะลบใน migration ถัดไป)
  isLead       Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([userId, teamId])
  @@index([teamId])
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  passwordHash       String
  active             Boolean            @default(true)
  /// null = ยังไม่ได้ยืนยันว่าเป็นเจ้าของอีเมลนี้ (สมัครเองและยังไม่กดลิงก์ยืนยัน) — รับคำเชิญในแอปไม่ได้จนกว่าจะยืนยัน
  emailVerifiedAt    DateTime?          @db.Timestamptz(3)
  /// session ที่ออกก่อนเวลานี้ใช้ไม่ได้ — เปลี่ยน/รีเซ็ตรหัสผ่านแล้วเครื่องอื่นหลุดออก
  passwordChangedAt  DateTime?          @db.Timestamptz(3)
  /// รับอีเมลแจ้งเตือน (งานใหม่ ความคิดเห็น) — ส่งเฉพาะเมื่อยืนยันอีเมลแล้ว
  emailNotifications Boolean            @default(true)
  notifications      Notification[]
  roleId             String
  role               Role               @relation(fields: [roleId], references: [id])
  memberships        TeamMember[]
  standups           Standup[]
  pushSubs           PushSubscription[]
  /// มีค่าเมื่อมีรูปโปรไฟล์ — ใช้เป็นเวอร์ชันใน URL รูป (?v=) เพื่อให้ cache ได้นานแต่เปลี่ยนรูปแล้วเห็นทันที
  avatarUpdatedAt    DateTime?          @db.Timestamptz(3)
  avatar             Avatar?
  tasks              Task[]             @relation("TaskAssignee")
  createdTasks       Task[]             @relation("TaskCreator")
  comments           Comment[]
  attachments        Attachment[]       @relation("AttachmentUploader")
  markedFiles        Attachment[]       @relation("AttachmentMarker")
  sentInvites        Invite[]           @relation("InviteSender")
  acceptedInvites    Invite[]           @relation("InviteAccepter")
  authTokens         AuthToken[]
  createdNotes       Note[]             @relation("NoteCreator")
  personalSpace      Team?              @relation("PersonalSpace")
  updatedNotes       Note[]             @relation("NoteEditor")
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  noteFavorites      NoteFavorite[]
  apiTokens          ApiToken[]
  oauthCodes         OAuthCode[]
  identities         UserIdentity[]
  resolvedComments   Comment[]          @relation("CommentResolver")
  assignedComments   Comment[]          @relation("CommentAssignee")
  assignerComments   Comment[]          @relation("CommentAssigner")
  refsTo             Ref[]              @relation("RefToUser")
  /// ภาษาที่ใช้ในแอป อีเมล และแจ้งเตือนที่ส่งถึงคนนี้ ("th" | "en")
  locale             String             @default("th")
}

/// Daily scrum หนึ่งรายการต่อคน ต่อทีม ต่อวัน — กระดานของแต่ละทีมแยกกัน
/// teamId = null เฉพาะข้อมูลเก่าที่เจ้าของไม่มีทีม หรือทีมถูกลบไปแล้ว
model Standup {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  date           DateTime  @db.Date
  /// [{ text, progress }] — ยกมาจาก todayTasks ของครั้งก่อน แล้วอัปเดต % ความคืบหน้า (100 = เสร็จ)
  yesterdayTasks Json      @default("[]")
  /// [{ text, progress? }] — progress = % ตั้งต้นของงานที่ยกมาทำต่อ
  todayTasks     Json      @default("[]")
  blockers       String?
  notWorking     String?
  workingWell    String?
  comments       Comment[]
  refsFrom       Ref[]     @relation("RefFromStandup")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, teamId, date])
  @@index([teamId, date])
  @@index([date])
}

/// เครื่อง/เบราว์เซอร์ที่ผู้ใช้เปิดรับ push notification (1 คนมีได้หลายเครื่อง)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

/// งานที่มอบหมายให้สมาชิกในทีม — เช็กอินอ้างถึงงานนี้ด้วย taskId แล้วอัปเดต progress กลับมาที่นี่
model Task {
  id          String           @id @default(cuid())
  /// เลขงานรันต่อทีม (#12) ให้คนอ้างถึงได้ — null เฉพาะงานที่สร้างระหว่างช่วง deploy
  number      Int?
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  /// คนที่สร้าง/มอบหมาย (null = บัญชีถูกลบไปแล้ว)
  createdById String?
  createdBy   User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  /// 0–100, 100 = เสร็จ
  progress    Int              @default(0)
  dueDate     DateTime?        @db.Date
  doneAt      DateTime?        @db.Timestamptz(3)
  /// ลบแบบซ่อนไว้ก่อน เพื่อให้กด "เลิกทำ" ได้ — query ทั่วไปต้องกรอง deletedAt = null
  deletedAt   DateTime?        @db.Timestamptz(3)
  comments    Comment[]
  attachments Attachment[]
  /// โน้ตที่อ้างถึงงานนี้ด้วย #เลขงาน
  noteLinks   NoteLink[]
  /// งานแม่ (งานย่อยมีได้ชั้นเดียว: งานที่มีงานแม่จะเป็นงานแม่ของงานอื่นไม่ได้) — ลบงานแม่แล้วงานย่อยกลายเป็นงานปกติ
  parentId    String?
  parent      Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]           @relation("Subtasks")
  labels      TaskLabel[]
  /// งานที่งานนี้ต้องรอ (blocked-by) และงานที่รองานนี้อยู่
  blockedBy   TaskDependency[] @relation("DependencyTask")
  blocks      TaskDependency[] @relation("DependencyBlocker")
  refsFrom    Ref[]            @relation("RefFromTask")
  refsTo      Ref[]            @relation("RefToTask")
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([teamId, number])
  @@index([parentId])
  @@index([teamId, assigneeId])
  @@index([assigneeId, progress])
}

/// ความคิดเห็นใต้งาน (taskId) หรือใต้เช็กอิน (standupId) — ต้องมีอย่างใดอย่างหนึ่งเท่านั้น (CHECK ใน migration)
model Comment {
  id           String       @id @default(cuid())
  authorId     String
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  standupId    String?
  standup      Standup?     @relation(fields: [standupId], references: [id], onDelete: Cascade)
  /// ความคิดเห็นในโน้ต — ต้องมีเป้าหมายอย่างใดอย่างหนึ่งพอดี: งาน / เช็กอิน / โน้ต (CHECK ใน migration)
  noteId       String?      @db.Uuid
  note         Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  /// มีค่า = คำตอบในเธรด (เป้าหมายเดียวกับความคิดเห็นแรกของเธรด) — เธรดซ้อนได้ชั้นเดียว
  parentId     String?
  parent       Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]    @relation("CommentReplies")
  /// ข้อความในโน้ตที่ความคิดเห็นยึดไว้ (ข้อความที่เลือก + คำรอบข้างไว้หาตำแหน่งใหม่เมื่อโน้ตถูกแก้) — ว่าง = คอมเมนต์ทั้งโน้ต
  anchorQuote  String?
  anchorPrefix String?
  anchorSuffix String?
  /// ปิดเธรดแล้ว ("แก้ไขแล้ว" / อ่านแล้ว / ตรวจผ่าน)
  resolvedAt   DateTime?    @db.Timestamptz(3)
  resolvedById String?
  resolvedBy   User?        @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// มอบหมายเธรดให้คนทำต่อ (ขอให้อ่าน / ตรวจ / แก้) — ไปขึ้นในหน้า "รอฉัน" จนกว่าจะปิด
  assigneeId   String?
  assignee     User?        @relation("CommentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignKind   AssignKind?
  /// คนที่มอบหมายครั้งล่าสุด — "แก้แล้ว" ส่งเธรดกลับไปให้คนนี้ตรวจต่อ
  assignedById String?
  assignedBy   User?        @relation("CommentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  /// ตรวจผ่านเมื่อ — โน้ตที่แก้หลังเวลานี้แสดงว่า "แก้ไขหลังตรวจ"
  approvedAt   DateTime?    @db.Timestamptz(3)
  editedAt     DateTime?    @db.Timestamptz(3)
  refsFrom     Ref[]        @relation("RefFromComment")
  /// ว่างได้เมื่อความคิดเห็นมีแต่ไฟล์แนบ
  body         String
  /// มีค่า = รายการ "อัปเดตความคืบหน้า" ของงาน (จาก % เดิม → % ใหม่) โดย body คือเหตุผล (ว่างได้)
  progressFrom Int?
  progressTo   Int?
  /// true = รายการ "เปลี่ยนกำหนดส่ง" ของงาน (dueFrom → dueTo, ว่าง = ไม่มีกำหนด) โดย body คือเหตุผล
  dueChange    Boolean      @default(false)
  dueFrom      DateTime?    @db.Date
  dueTo        DateTime?    @db.Date
  attachments  Attachment[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([taskId, createdAt])
  @@index([standupId, createdAt])
  @@index([noteId, createdAt])
  @@index([parentId])
  @@index([assigneeId, resolvedAt])
}

/// สิ่งที่ขอให้ผู้รับมอบหมายเธรดทำ
enum AssignKind {
  READ
  REVIEW
  EDIT
}

/// ป้ายกำกับงานของทีม (ทีมย่อยใช้ป้ายของทีมแม่ได้ด้วย)
model Label {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  /// ชื่อสีจากชุดสีของ Pace (ไม่ใช่ค่าสีอิสระ) — ดู src/lib/labels.ts
  color     String      @default("slate")
  tasks     TaskLabel[]
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([teamId, name])
}

model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

/// งาน taskId ต้องรองาน blockedById เสร็จก่อน (ทีมเดียวกันเท่านั้น ห้ามวน — ตรวจในโค้ด)
model TaskDependency {
  taskId      String
  task        Task     @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  blockedById String
  blockedBy   Task     @relation("DependencyBlocker", fields: [blockedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, blockedById])
  @@index([blockedById])
}

/// การอ้างถึงที่ดึงจากข้อความตอนบันทึก: #งาน, [[โน้ต]], @คน — จากรายละเอียดงาน ความคิดเห็น เช็กอิน และ @คน ในโน้ต
/// (ลิงก์ โน้ต → โน้ต/งาน อยู่ใน NoteLink เดิม ซึ่งแผนผังโน้ตใช้) · ใช้ทำลิงก์ย้อนกลับและแจ้งเตือนคนที่ถูกแท็ก
model Ref {
  id            BigInt   @id @default(autoincrement())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromNoteId    String?  @db.Uuid
  fromNote      Note?    @relation("RefFromNote", fields: [fromNoteId], references: [id], onDelete: Cascade)
  fromTaskId    String?
  fromTask      Task?    @relation("RefFromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  fromCommentId String?
  fromComment   Comment? @relation("RefFromComment", fields: [fromCommentId], references: [id], onDelete: Cascade)
  fromStandupId String?
  fromStandup   Standup? @relation("RefFromStandup", fields: [fromStandupId], references: [id], onDelete: Cascade)
  toNoteId      String?  @db.Uuid
  toNote        Note?    @relation("RefToNote", fields: [toNoteId], references: [id], onDelete: Cascade)
  toTaskId      String?
  toTask        Task?    @relation("RefToTask", fields: [toTaskId], references: [id], onDelete: Cascade)
  toUserId      String?
  toUser        User?    @relation("RefToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([fromNoteId])
  @@index([fromTaskId])
  @@index([fromCommentId])
  @@index([fromStandupId])
  @@index([toNoteId])
  @@index([toTaskId])
  @@index([toUserId, createdAt])
}

/// คำเชิญเข้าทีม — รับได้ 2 ทาง: เปิดลิงก์ที่มี token (ใช้ได้ครั้งเดียว) หรือกดรับในแอปเมื่อ login ด้วยอีเมลที่ถูกเชิญและยืนยันอีเมลแล้ว
/// คำเชิญที่รับแล้วเก็บไว้ ใช้เป็น "คนที่เคยเชิญ" ให้เลือกเชิญเข้าทีมอื่นได้โดยไม่ต้องพิมพ์อีเมลใหม่
model Invite {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// ตัวพิมพ์เล็กเสมอ
  email        String
  access       TeamAccess @default(MEMBER)
  title        String?
  invitedById  String?
  invitedBy    User?      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  /// SHA-256 ของ token ในลิงก์ — ไม่เก็บ token จริง
  tokenHash    String     @unique
  expiresAt    DateTime   @db.Timestamptz(3)
  acceptedAt   DateTime?  @db.Timestamptz(3)
  acceptedById String?
  acceptedBy   User?      @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([teamId])
  @@index([email])
  @@index([invitedById])
}

/// แจ้งเตือนในแอป (กระดิ่ง) — แถวเกิดเร็วและอ่านตามลำดับเวลา จึงใช้เลขรันเป็น id
model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// path ภายในแอปที่จะเปิดเมื่อกด (ขึ้นต้นด้วย /)
  url       String
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// ตัวนับจำกัดความถี่ (login / สมัคร / ลืมรหัสผ่าน) ต่อ key เช่น "login:ip:1.2.3.4" — ดู src/lib/rate-limit.ts
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// token ใช้ครั้งเดียวที่ส่งทางอีเมล (ตั้งรหัสผ่านใหม่ / ยืนยันอีเมล) — เก็บเฉพาะ SHA-256
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, type])
}

/// ไฟล์แนบของงาน (taskId) หรือของความคิดเห็น (commentId) — ตัวไฟล์อยู่ใน Supabase Storage ที่ `path`
/// เป็นไฟล์ชั่วคราว: ลบเองเมื่อเลย expiresAt เว้นแต่ถูก mark ว่าสำคัญ (importantAt) — ดู /api/cron/cleanup-files
/// taskId/commentId เป็น SetNull: แถวที่ไม่เหลือเจ้าของจะถูก cron ลบพร้อมไฟล์ใน Storage
model Attachment {
  id            String    @id @default(cuid())
  uploaderId    String?
  uploader      User?     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commentId     String?
  comment       Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  name          String
  mimeType      String
  size          Int
  path          String    @unique
  /// null = ขอ URL อัปโหลดแล้วแต่ยังอัปโหลดไม่เสร็จ (ยังไม่แสดง)
  uploadedAt    DateTime? @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  importantAt   DateTime? @db.Timestamptz(3)
  importantById String?
  importantBy   User?     @relation("AttachmentMarker", fields: [importantById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([taskId])
  @@index([commentId])
  @@index([importantAt])
  @@index([expiresAt])
}

/// รูปโปรไฟล์ (ย่อเป็น 256×256 ในเบราว์เซอร์ก่อนอัปโหลด) — แยกตารางเพื่อไม่ให้ query ผู้ใช้ทั่วไปดึงไฟล์รูปมาด้วย
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum NoteKind {
  FOLDER
  NOTE
}

/// โน้ตและโฟลเดอร์ของทีม (ฐานความรู้แบบ Obsidian) — ทุกคนในทีมอ่านและแก้ได้
/// โครงสร้างโฟลเดอร์มาจาก parentId · เนื้อหาเป็น Markdown · ลิงก์ระหว่างโน้ตเขียนเป็น [[ชื่อโน้ต]] และอ้างงานด้วย #เลขงาน
model Note {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentId    String?        @db.Uuid
  parent      Note?          @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Note[]         @relation("NoteTree")
  kind        NoteKind       @default(NOTE)
  title       String
  /// Markdown (โฟลเดอร์ไม่มีเนื้อหา)
  content     String         @default("")
  createdById String?
  createdBy   User?          @relation("NoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?          @relation("NoteEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  /// ลบแบบซ่อนไว้ — query ทั่วไปต้องกรอง deletedAt = null
  deletedAt   DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  linksOut    NoteLink[]     @relation("NoteLinkFrom")
  linksIn     NoteLink[]     @relation("NoteLinkTo")
  favorites   NoteFavorite[]
  comments    Comment[]
  refsFrom    Ref[]          @relation("RefFromNote")
  refsTo      Ref[]          @relation("RefToNote")

  @@index([teamId, parentId])
  @@index([teamId, title])
}

/// รายการโปรดของแต่ละคน (โน้ตหรือโฟลเดอร์) — เป็นของส่วนตัว คนอื่นในทีมไม่เห็น
model NoteFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String   @db.Uuid
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, noteId])
  @@index([noteId])
}

/// ความสัมพันธ์ที่ดึงจากเนื้อหาโน้ตตอนบันทึก: โน้ต → โน้ต ([[...]]) หรือ โน้ต → งาน (#12) — ใช้ทำ backlink และแผนผัง
model NoteLink {
  id       BigInt  @id @default(autoincrement())
  fromId   String  @db.Uuid
  from     Note    @relation("NoteLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toNoteId String? @db.Uuid
  toNote   Note?   @relation("NoteLinkTo", fields: [toNoteId], references: [id], onDelete: Cascade)
  toTaskId String?
  toTask   Task?   @relation(fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromId, toNoteId])
  @@unique([fromId, toTaskId])
  @@index([toNoteId])
  @@index([toTaskId])
}

/// โทเคนส่วนตัวสำหรับให้ผู้ช่วย AI เชื่อมเข้ามาผ่าน MCP (/api/mcp) — ทำได้เท่าที่เจ้าของบัญชีทำได้
/// เก็บเฉพาะ hash: ตัวโทเคนแสดงให้เห็นครั้งเดียวตอนสร้าง
model ApiToken {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String       @unique
  /// true = อ่านอย่างเดียว (เครื่องมือที่แก้ไขข้อมูลถูกปิด)
  readOnly    Boolean      @default(false)
  lastUsedAt  DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  /// มีค่าเมื่อออกผ่าน OAuth (เช่นตัวเชื่อมต่อของ claude.ai) — null = โทเคนที่ผู้ใช้สร้างเองจากหน้าบัญชี
  clientId    String?      @db.Uuid
  client      OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// โทเคน OAuth หมดอายุเร็วและต่ออายุด้วย refresh token — null = ไม่หมดอายุ (โทเคนที่สร้างเอง)
  expiresAt   DateTime?    @db.Timestamptz(3)
  refreshHash String?      @unique

  @@index([userId])
}

/// โปรแกรมที่ลงทะเบียนขอเชื่อมผ่าน OAuth (ลงทะเบียนเองได้ตามมาตรฐาน MCP) — เป็น public client ใช้ PKCE ไม่มี secret
model OAuthClient {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  redirectUris String[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  tokens       ApiToken[]
  codes        OAuthCode[]
}

/// รหัสอนุญาตใช้ครั้งเดียว อายุสั้น — แลกเป็นโทเคนที่ /api/oauth/token
model OAuthCode {
  codeHash      String      @id
  clientId      String      @db.Uuid
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  readOnly      Boolean     @default(false)
  expiresAt     DateTime    @db.Timestamptz(3)
}

/// บัญชี Google / Microsoft ที่ผูกกับผู้ใช้ — ใช้เข้าสู่ระบบแทนรหัสผ่าน (subject = รหัสผู้ใช้ฝั่งผู้ให้บริการ ไม่เปลี่ยนแม้เปลี่ยนอีเมล)
model UserIdentity {
  provider  String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([provider, subject])
  @@unique([userId, provider])
}

/// แพ็กเกจของ workspace (ทีมระดับบน) — ไม่มีแถว = ฟรี
enum Plan {
  FREE
  TEAM
}

/// การสมัครแพ็กเกจของ workspace (ทีมระดับบนเท่านั้น ทีมย่อยใช้ของทีมแม่) — ดู src/lib/plans.ts
model Subscription {
  teamId               String    @id
  team                 Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  /// จำนวนที่นั่งที่จ่ายเงินแล้ว (= จำนวนคนสูงสุดใน workspace)
  seats                Int       @default(0)
  /// สถานะจาก Stripe: active / trialing / past_due / canceled / unpaid / incomplete …
  status               String    @default("none")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean   @default(false)
  /// ผู้ดูแลระบบให้ใช้แพ็กเกจทีมฟรี (ทดลอง / พาร์ตเนอร์) ถึงวันนี้ ด้วยจำนวนที่นั่ง compSeats
  compUntil            DateTime? @db.Timestamptz(3)
  compSeats            Int?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
}

/// webhook ของผู้ให้บริการชำระเงินที่ประมวลผลแล้ว (กันประมวลผลซ้ำ)
model BillingEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// ค่าตั้งของระบบที่ผู้ดูแลปรับจากหน้าเว็บได้ (ไม่ต้อง deploy) — key เดียวต่อค่า ไม่มีแถว = ใช้ค่าเริ่มต้นในโค้ด
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
