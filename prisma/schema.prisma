generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase บน Vercel: DATABASE_URL = pooler (6543), DIRECT_URL = direct/session (5432) สำหรับ migrate
  // Docker / local: ใส่ค่าเดียวกันทั้งสองตัว
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Role ระดับระบบ — `level` ≥ 100 = ผู้ดูแลแพลตฟอร์ม (ดู src/lib/permissions.ts)
/// สิทธิ์ในทีมอยู่ที่ TeamMember.access และชื่อบทบาทในทีมอยู่ที่ TeamMember.title
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

/// ทีมซ้อนได้ 2 ชั้น: ทีมใหญ่ (parentId = null) = workspace ของลูกค้าแต่ละราย → ทีมย่อย
/// ชื่อทีมใหญ่ซ้ำกันได้ (คนละลูกค้า) — ชื่อทีมย่อยห้ามซ้ำภายในทีมใหญ่เดียวกัน
model Team {
  id        String       @id @default(cuid())
  name      String
  parentId  String?
  parent    Team?        @relation("TeamTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Team[]       @relation("TeamTree")
  members   TeamMember[]
  standups  Standup[]
  tasks     Task[]
  invites   Invite[]
  createdAt DateTime     @default(now())

  @@unique([parentId, name])
  @@index([parentId])
}

/// สิทธิ์ของสมาชิกในทีมนั้น (ไม่ใช่สิทธิ์ระดับระบบ)
/// OWNER = เจ้าของทีม จัดการสมาชิก/ตั้งค่าทีมได้ · LEAD = เห็นภาพรวมและมอบหมายงานในทีมนี้ + ทีมย่อย · MEMBER = สมาชิกทั่วไป
enum TeamAccess {
  OWNER
  LEAD
  MEMBER
}

/// สมาชิกทีม — คนหนึ่งอยู่ได้หลายทีม สิทธิ์และชื่อบทบาทกำหนดแยกต่อทีม
model TeamMember {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  access       TeamAccess @default(MEMBER)
  /// ชื่อบทบาทในทีมนี้ที่ตั้งเองได้ เช่น Dev, PM, PO, Scrum Master (ไม่มีผลต่อสิทธิ์)
  title        String?
  /// false = ดูแล/สังเกตการณ์อย่างเดียว ไม่ต้องเช็กอินและไม่ถูกนับในภาพรวม
  participates Boolean    @default(true)
  /// เลิกใช้แล้ว — ใช้ access แทน (คงคอลัมน์ไว้ให้ถอยกลับได้ จะลบใน migration ถัดไป)
  isLead       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@id([userId, teamId])
  @@index([teamId])
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  passwordHash       String
  active             Boolean            @default(true)
  /// null = ยังไม่ได้ยืนยันว่าเป็นเจ้าของอีเมลนี้ (สมัครเองและยังไม่กดลิงก์ยืนยัน) — รับคำเชิญในแอปไม่ได้จนกว่าจะยืนยัน
  emailVerifiedAt    DateTime?
  /// session ที่ออกก่อนเวลานี้ใช้ไม่ได้ — เปลี่ยน/รีเซ็ตรหัสผ่านแล้วเครื่องอื่นหลุดออก
  passwordChangedAt  DateTime?
  /// รับอีเมลแจ้งเตือน (งานใหม่ ความคิดเห็น) — ส่งเฉพาะเมื่อยืนยันอีเมลแล้ว
  emailNotifications Boolean            @default(true)
  notifications      Notification[]
  roleId             String
  role               Role               @relation(fields: [roleId], references: [id])
  memberships        TeamMember[]
  standups           Standup[]
  pushSubs           PushSubscription[]
  /// มีค่าเมื่อมีรูปโปรไฟล์ — ใช้เป็นเวอร์ชันใน URL รูป (?v=) เพื่อให้ cache ได้นานแต่เปลี่ยนรูปแล้วเห็นทันที
  avatarUpdatedAt    DateTime?
  avatar             Avatar?
  tasks              Task[]             @relation("TaskAssignee")
  createdTasks       Task[]             @relation("TaskCreator")
  comments           Comment[]
  attachments        Attachment[]       @relation("AttachmentUploader")
  markedFiles        Attachment[]       @relation("AttachmentMarker")
  sentInvites        Invite[]           @relation("InviteSender")
  acceptedInvites    Invite[]           @relation("InviteAccepter")
  authTokens         AuthToken[]
  createdAt          DateTime           @default(now())
}

/// Daily scrum หนึ่งรายการต่อคน ต่อทีม ต่อวัน — กระดานของแต่ละทีมแยกกัน
/// teamId = null เฉพาะข้อมูลเก่าที่เจ้าของไม่มีทีม หรือทีมถูกลบไปแล้ว
model Standup {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  date           DateTime  @db.Date
  /// [{ text, progress }] — ยกมาจาก todayTasks ของครั้งก่อน แล้วอัปเดต % ความคืบหน้า (100 = เสร็จ)
  yesterdayTasks Json      @default("[]")
  /// [{ text, progress? }] — progress = % ตั้งต้นของงานที่ยกมาทำต่อ
  todayTasks     Json      @default("[]")
  blockers       String?
  notWorking     String?
  workingWell    String?
  comments       Comment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, teamId, date])
  @@index([teamId, date])
  @@index([date])
}

/// เครื่อง/เบราว์เซอร์ที่ผู้ใช้เปิดรับ push notification (1 คนมีได้หลายเครื่อง)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// งานที่มอบหมายให้สมาชิกในทีม — เช็กอินอ้างถึงงานนี้ด้วย taskId แล้วอัปเดต progress กลับมาที่นี่
model Task {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  /// คนที่สร้าง/มอบหมาย (null = บัญชีถูกลบไปแล้ว)
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  /// 0–100, 100 = เสร็จ
  progress    Int          @default(0)
  dueDate     DateTime?    @db.Date
  doneAt      DateTime?
  /// ลบแบบซ่อนไว้ก่อน เพื่อให้กด "เลิกทำ" ได้ — query ทั่วไปต้องกรอง deletedAt = null
  deletedAt   DateTime?
  comments    Comment[]
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, assigneeId])
  @@index([assigneeId, progress])
}

/// ความคิดเห็นใต้งาน (taskId) หรือใต้เช็กอิน (standupId) — ต้องมีอย่างใดอย่างหนึ่งเท่านั้น (CHECK ใน migration)
model Comment {
  id           String       @id @default(cuid())
  authorId     String
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  standupId    String?
  standup      Standup?     @relation(fields: [standupId], references: [id], onDelete: Cascade)
  /// ว่างได้เมื่อความคิดเห็นมีแต่ไฟล์แนบ
  body         String
  /// มีค่า = รายการ "อัปเดตความคืบหน้า" ของงาน (จาก % เดิม → % ใหม่) โดย body คือเหตุผล (ว่างได้)
  progressFrom Int?
  progressTo   Int?
  attachments  Attachment[]
  createdAt    DateTime     @default(now())

  @@index([taskId, createdAt])
  @@index([standupId, createdAt])
}

/// คำเชิญเข้าทีม — รับได้ 2 ทาง: เปิดลิงก์ที่มี token (ใช้ได้ครั้งเดียว) หรือกดรับในแอปเมื่อ login ด้วยอีเมลที่ถูกเชิญและยืนยันอีเมลแล้ว
/// คำเชิญที่รับแล้วเก็บไว้ ใช้เป็น "คนที่เคยเชิญ" ให้เลือกเชิญเข้าทีมอื่นได้โดยไม่ต้องพิมพ์อีเมลใหม่
model Invite {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// ตัวพิมพ์เล็กเสมอ
  email        String
  access       TeamAccess @default(MEMBER)
  title        String?
  invitedById  String?
  invitedBy    User?      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  /// SHA-256 ของ token ในลิงก์ — ไม่เก็บ token จริง
  tokenHash    String     @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?      @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([teamId])
  @@index([email])
  @@index([invitedById])
}

/// แจ้งเตือนในแอป (กระดิ่ง) — แถวเกิดเร็วและอ่านตามลำดับเวลา จึงใช้เลขรันเป็น id
model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// path ภายในแอปที่จะเปิดเมื่อกด (ขึ้นต้นด้วย /)
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// ตัวนับจำกัดความถี่ (login / สมัคร / ลืมรหัสผ่าน) ต่อ key เช่น "login:ip:1.2.3.4" — ดู src/lib/rate-limit.ts
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// token ใช้ครั้งเดียวที่ส่งทางอีเมล (ตั้งรหัสผ่านใหม่ / ยืนยันอีเมล) — เก็บเฉพาะ SHA-256
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// ไฟล์แนบของงาน (taskId) หรือของความคิดเห็น (commentId) — ตัวไฟล์อยู่ใน Supabase Storage ที่ `path`
/// เป็นไฟล์ชั่วคราว: ลบเองเมื่อเลย expiresAt เว้นแต่ถูก mark ว่าสำคัญ (importantAt) — ดู /api/cron/cleanup-files
/// taskId/commentId เป็น SetNull: แถวที่ไม่เหลือเจ้าของจะถูก cron ลบพร้อมไฟล์ใน Storage
model Attachment {
  id            String    @id @default(cuid())
  uploaderId    String?
  uploader      User?     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commentId     String?
  comment       Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  name          String
  mimeType      String
  size          Int
  path          String    @unique
  /// null = ขอ URL อัปโหลดแล้วแต่ยังอัปโหลดไม่เสร็จ (ยังไม่แสดง)
  uploadedAt    DateTime?
  expiresAt     DateTime
  importantAt   DateTime?
  importantById String?
  importantBy   User?     @relation("AttachmentMarker", fields: [importantById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([taskId])
  @@index([commentId])
  @@index([importantAt])
  @@index([expiresAt])
}

/// รูปโปรไฟล์ (ย่อเป็น 256×256 ในเบราว์เซอร์ก่อนอัปโหลด) — แยกตารางเพื่อไม่ให้ query ผู้ใช้ทั่วไปดึงไฟล์รูปมาด้วย
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}
