# PostgreSQL (local / docker: ใช้ค่าเดียวกันทั้งสองตัว)
DATABASE_URL="postgresql://scrum:scrum@localhost:5432/scrum?schema=public"
DIRECT_URL="postgresql://scrum:scrum@localhost:5432/scrum?schema=public"

# Supabase (Vercel):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# timezone ที่ใช้ตัดวันของ daily scrum
APP_TIMEZONE="Asia/Bangkok"

# admin คนแรก (สร้างตอน seed ครั้งแรกเท่านั้น — เปลี่ยนรหัสผ่านหลัง login)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"

# Push notification เตือนเช็กอิน (ไม่ตั้ง = ปิดฟีเจอร์)
# สร้าง key: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="https://your-domain.example"   # URL ของเว็บ หรือ mailto: ของผู้ดูแล
# secret สำหรับเรียก /api/cron/checkin-reminder (Vercel Cron ส่งให้อัตโนมัติถ้าตั้งตัวแปรนี้)
# CRON_SECRET=""

# ตั้งเป็น false เฉพาะตอนรัน production build ผ่าน http (เช่น docker บนเครื่อง)
# COOKIE_SECURE="false"
